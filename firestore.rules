rules_version = '2';

// PAYDO.TJ — Firestore Security Rules
// PHASE 1: танҳо коллексияи `users` муайян шудааст.
// Ҳар феча (marketplace, jobs, chat, ...) қоидаҳои худро дар феҷаи
// дахлдор илова мекунад — ин файлро дар PHASE 4+ идома медиҳем.
service cloud.firestore {
  match /databases/{database}/documents {

    // Корбар танҳо документи худро сохта/хонда/навишта метавонад.
    // Дигарон метавонанд профили ҷамъиятиро хонанд (масалан барои
    // намоиши profile-и seller дар marketplace), вале не тағйир диҳанд.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId;
      allow delete: if false; // Ҳисобро тавассути admin panel нест кардан лозим (PHASE 19)
    }

    // Маҳсулот (PHASE 4/6): хондан барои ҳама кушода, навиштан танҳо
    // барои соҳиби маҳсулот (sellerId). Иҷозати "create" бе sellerId
    // = auth.uid дода намешавад, то корбар аз номи дигаре нанависад.
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.sellerId == request.auth.uid;
      // PHASE 16: rating/reviewsCount танҳо аз Cloud Function
      // (Admin SDK, functions/index.js) навсозӣ мешаванд — на бевосита
      // аз client. Ин пешгирии дасткории rating бе баҳои воқеӣ мекунад
      // (ниг. docs/reviews.md барои сабаби тарроҳӣ).
      allow update, delete: if request.auth != null
                    && resource.data.sellerId == request.auth.uid;
    }

    // Favorites (PHASE 4): ҳар корбар танҳо favorite-и худро идора
    // мекунад; docId бо конвенсияи `{uid}_{itemId}` сохта мешавад.
    match /favorites/{favoriteId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Бизнес (PHASE 5): documentId = ownerId (ниг. docs/database.md).
    // Хондан барои ҳама кушода (бизнес-профил бояд ҷамъиятӣ намоён
    // бошад), навиштан танҳо барои соҳиб.
    match /businesses/{ownerId} {
      allow read: if true;
      allow create, update: if request.auth != null
                    && request.auth.uid == ownerId
                    && request.resource.data.ownerId == ownerId;
      allow delete: if false; // тавассути admin panel (PHASE 19)
    }

    // Orders (PHASE 7): items embedded (ниг. эзоҳи тарроҳӣ дар
    // lib/models/order_model.dart). Хондан: харидор ё яке аз
    // seller-ҳои дар sellerIds. Навиштан (create): танҳо харидор аз
    // номи худ. Тағйир (масалан status): харидор (cancel) ё seller
    // (пешрафти status).
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && (resource.data.customerId == request.auth.uid
                      || request.auth.uid in resource.data.sellerIds);
      allow create: if request.auth != null
                    && request.resource.data.customerId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.customerId == request.auth.uid
                        || request.auth.uid in resource.data.sellerIds);
      allow delete: if false;
    }

    // Chat (PHASE 8): chatId детерминистӣ (`{uid1}_{uid2}`, ниг.
    // lib/features/chat/domain/chat_repository.dart). Танҳо 2
    // иштирокчии дар `participantIds` метавонанд хонанд/нависанд.
    match /chats/{chatId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participantIds;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
                    && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false; // хабарҳо ивазнашаванда/нестнашавандаанд
      }
    }

    // Вакансия (PHASE 9): хондан кушода, навиштан/тағйир/нест кардан
    // танҳо барои соҳиби вакансия (employerId).
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.employerId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.employerId == request.auth.uid;
    }

    // Профили корҷӳ (PHASE 9): documentId = uid, ҳамон нақшаи
    // businesses/{ownerId}. Хондан кушода (барои ҳамон корфармоён
    // рӳйхати "Корҷӳён"-ро бинанд, ба ҷуз агар isVisible=false бошад —
    // он дар сатҳи client filter мешавад, на дар rules, зеро rules
    // намедонанд "ин query аз рӳи isVisible аст" бе санҳиши иловагӣ).
    match /worker_profiles/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Аризаи корҷӳ (PHASE 9): docId = `{jobId}_{workerId}`. Хондан:
    // худи корҷӳ ё корфармои вакансия. Сохтан: танҳо корҷӳ аз номи худ.
    // Тағйир (қабул/рад): танҳо корфармо.
    match /job_applications/{applicationId} {
      allow read: if request.auth != null
                  && (resource.data.workerId == request.auth.uid
                      || resource.data.employerId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.workerId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.employerId == request.auth.uid;
      allow delete: if false;
    }

    // Профили хизматрасон (PHASE 10): documentId = uid, ҳамон нақшаи
    // worker_profiles/businesses.
    match /services/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Фармоиши хизматрасонӣ (PHASE 10): хондан/тағйир барои харидор ё
    // хизматрасони дахлдор; сохтан танҳо аз номи худи харидор.
    match /service_orders/{orderId} {
      allow read: if request.auth != null
                  && (resource.data.customerId == request.auth.uid
                      || resource.data.providerId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.customerId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.customerId == request.auth.uid
                        || resource.data.providerId == request.auth.uid);
      allow delete: if false;
    }

    // Дафтари ҳисоб (PHASE 11): маълумоти пурра хусусӣ — танҳо соҳиб
    // (ownerId == auth.uid) метавонад хонад/нависад. Sales/Inventory
    // алоҳида нестанд (ниг. эзоҳи тарроҳӣ дар
    // lib/features/accounting/domain/accounting_repository.dart) —
    // онҳо аз products/orders (rules-и аллакай мавҷуда) истифода мешаванд.
    match /debts/{debtId} {
      allow read, update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
    }

    match /expenses/{expenseId} {
      allow read, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
    }

    // Профили courier (PHASE 12): documentId = uid. Хондан кушода
    // (Business бояд рӯйхати courier-ҳои озодро бинад), навиштан танҳо
    // барои соҳиб. Диққат: setCourierStatus (busy/available) низ аз
    // ҳамин "update" истифода мешавад — ҳам аз тарафи courier (худаш
    // status иваз мекунад) ва ҳам аз тарафи система ҳангоми таъин
    // шудан/расонидан (ниг. DeliveryActionController). Барои
    // соддагии MVP, "update" барои соҳиб кушода аст; санҷиши "танҳо
    // системаро иҷозат деҳ вақте расонида шуд" дар PHASE 20 иловатар
    // мешавад агар лозим шавад.
    match /couriers/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Иҷрои доставка (PHASE 12): docId = orderId. Хондан/тағйир барои
    // courier-и таъиншуда ё харидори order (мустақим аз resource.data,
    // на аз orders/{orderId}, то rule-и Storage-барин cross-collection
    // мураккаб нашавад). Сохтан: ин ҷо санҷиши "фиристанда seller аст"
    // намекунем (маҳдудияти MVP — ниг. эзоҳи боло), вале customerId/
    // courierId бояд аз request.resource бошад.
    match /deliveries/{deliveryId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.courierId
                      || request.auth.uid == resource.data.customerId);
      allow create: if request.auth != null;
      allow update: if request.auth != null
                  && request.auth.uid == resource.data.courierId;
      allow delete: if false;
    }

    // Notifications (PHASE 15): гиранда танҳо метавонад хонад/mark-as-
    // read кунад. "create" барои ҳар корбари ворид шуда кушода аст,
    // зеро фиристанда одатан НА худи гиранда аст (масалан customer
    // барои seller notification месозад) — санҷиши "фиристанда ҳаққи
    // ин амалро дорад" дар ин марҳила иҷро намешавад (маҳдудияти MVP,
    // мисли `deliveries.create` дар PHASE 12/14).
    match /notifications/{notificationId} {
      allow read, update: if request.auth != null
                          && resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null;
      allow delete: if false;
    }

    // Баҳо/шарҳ (PHASE 16): docId детерминистӣ
    // (`{contextId}_{targetType}_{targetId}`) — пешгирии баҳои такрорӣ.
    // Хондан кушода (баҳо бояд ҷамъиятӣ намоён бошад). Сохтан танҳо аз
    // номи худи муаллиф. Тағйир/нест кардан бастаанд — баҳо баъд аз
    // фиристодан ивазнашаванда аст (мисли паёмҳои чат).
    // rating/reviewsCount-и target ИН ҶО навсозӣ НАМЕШАВАД — он
    // вазифаи Cloud Function-и `recalculateRatingOnReviewCreated`
    // (functions/index.js, Admin SDK) аст, ниг. docs/reviews.md.
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Ҳама коллексияҳои дигар то муайян шуданашон дар марҳилаҳои
    // дахлдор пурра баста мебошанд (default deny).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
